{
  "name": "graphql-development-assistant",
  "version": "2.0.0",
  "description": "Production-grade GraphQL plugin with 7 specialized agents for schema design, resolvers, Apollo Server/Client, security, and code generation",
  "author": "Claude Code",
  "homepage": "https://github.com/pluginagentmarketplace/custom-plugin-graphql",
  "repository": "https://github.com/pluginagentmarketplace/custom-plugin-graphql",
  "keywords": [
    "graphql",
    "apollo",
    "apollo-server",
    "apollo-client",
    "graphql-schema",
    "graphql-resolvers",
    "dataloader",
    "graphql-security",
    "graphql-codegen",
    "typescript",
    "react-hooks",
    "api-development",
    "federation"
  ],
  "agents": [
    "./agents/01-graphql-fundamentals.md",
    "./agents/02-graphql-schema.md",
    "./agents/03-graphql-resolvers.md",
    "./agents/04-graphql-apollo-server.md",
    "./agents/05-graphql-apollo-client.md",
    "./agents/06-graphql-security.md",
    "./agents/07-graphql-codegen.md"
  ],
  "commands": [
    {
      "id": "learn",
      "name": "learn",
      "path": "./commands/learn.md",
      "description": "Interactive GraphQL learning path with guided roadmaps"
    },
    {
      "id": "browse-agent",
      "name": "browse-agent",
      "path": "./commands/browse-agent.md",
      "description": "Explore 7 specialized GraphQL agents"
    },
    {
      "id": "assess",
      "name": "assess",
      "path": "./commands/assess.md",
      "description": "GraphQL knowledge assessment and skill gap analysis"
    },
    {
      "id": "roadmap",
      "name": "roadmap",
      "path": "./commands/roadmap.md",
      "description": "Complete GraphQL learning roadmaps"
    }
  ],
  "skills": [
    "./skills/graphql-fundamentals/SKILL.md",
    "./skills/graphql-schema-design/SKILL.md",
    "./skills/graphql-resolvers/SKILL.md",
    "./skills/graphql-apollo-server/SKILL.md",
    "./skills/graphql-apollo-client/SKILL.md",
    "./skills/graphql-security/SKILL.md",
    "./skills/graphql-codegen/SKILL.md"
  ],
  "license": "SEE LICENSE IN LICENSE"
}