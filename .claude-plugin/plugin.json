{
  "name": "graphql-development-assistant",
  "version": "1.0.0",
  "description": "GraphQL plugin with specialized agents for schema design, resolvers, Apollo, and API optimization",
  "author": "Claude Code",
  "homepage": "https://github.com/pluginagentmarketplace/custom-plugin-graphql",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamranahmedse/developer-roadmap"
  },
  "keywords": [
    "learning",
    "roadmap",
    "backend",
    "frontend",
    "devops",
    "data-science",
    "system-design",
    "security",
    "ai-ml",
    "developer-education",
    "skill-progression"
  ],
  "agents": [
    "./agents/01-graphql-fundamentals.md",
    "./agents/02-graphql-schema.md",
    "./agents/03-graphql-resolvers.md",
    "./agents/04-graphql-apollo-server.md",
    "./agents/05-graphql-apollo-client.md",
    "./agents/06-graphql-security.md",
    "./agents/07-graphql-codegen.md"
  ],
  "commands": [
    {
      "id": "learn",
      "name": "learn",
      "path": "commands/learn.md",
      "description": "Start interactive learning with roadmap guidance"
    },
    {
      "id": "browse-agent",
      "name": "browse-agent",
      "path": "commands/browse-agent.md",
      "description": "Explore all 7 specialized agents"
    },
    {
      "id": "assess",
      "name": "assess",
      "path": "commands/assess.md",
      "description": "Evaluate your knowledge and find skill gaps"
    },
    {
      "id": "roadmap",
      "name": "roadmap",
      "path": "commands/roadmap.md",
      "description": "View detailed roadmap for any role"
    }
  ],
  "skills": [
    "./skills/graphql-fundamentals/SKILL.md",
    "./skills/graphql-schema-design/SKILL.md",
    "./skills/graphql-resolvers/SKILL.md",
    "./skills/graphql-apollo-server/SKILL.md",
    "./skills/graphql-apollo-client/SKILL.md",
    "./skills/graphql-security/SKILL.md",
    "./skills/graphql-codegen/SKILL.md"
  ],
